(export (version "E")
  (design
    (source "555_blinker.kicad_sch")
    (tool "Eeschema 8.0")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "555 LED blinker"))))
  (components
    (comp (ref "C1")
      (value "10uF")
      (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm")
      (libsource (lib "Device") (part "C_Polarized") (description "Polarized capacitor")))
    (comp (ref "C2")
      (value "10nF")
      (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm")
      (libsource (lib "Device") (part "C") (description "Unpolarized capacitor")))
    (comp (ref "D1")
      (value "LED")
      (footprint "LED_THT:LED_D5.0mm")
      (libsource (lib "Device") (part "LED") (description "Light emitting diode")))
    (comp (ref "J1")
      (value "Power")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "Connector") (part "Conn_01x02_Pin") (description "Generic connector, single row, 01x02")))
    (comp (ref "R1")
      (value "1k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R2")
      (value "10k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R3")
      (value "330")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "U1")
      (value "NE555P")
      (footprint "Package_DIP:DIP-8_W7.62mm")
      (libsource (lib "Timer") (part "NE555P") (description "Precision Timers, 555 compatible, PDIP-8"))))
  (nets
    (net (code "1") (name "+5V")
      (node (ref "J1") (pin "1") (pinfunction "Pin_1") (pintype "passive"))
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "U1") (pin "4") (pinfunction "R") (pintype "input"))
      (node (ref "U1") (pin "8") (pinfunction "VCC") (pintype "power_in")))
    (net (code "2") (name "GND")
      (node (ref "C1") (pin "2") (pintype "passive"))
      (node (ref "C2") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "1") (pinfunction "K") (pintype "passive"))
      (node (ref "J1") (pin "2") (pinfunction "Pin_2") (pintype "passive"))
      (node (ref "U1") (pin "1") (pinfunction "GND") (pintype "power_in")))
    (net (code "3") (name "/DIS")
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "R2") (pin "1") (pintype "passive"))
      (node (ref "U1") (pin "7") (pinfunction "DIS") (pintype "input")))
    (net (code "4") (name "/THR")
      (node (ref "C1") (pin "1") (pintype "passive"))
      (node (ref "R2") (pin "2") (pintype "passive"))
      (node (ref "U1") (pin "2") (pinfunction "TR") (pintype "input"))
      (node (ref "U1") (pin "6") (pinfunction "THR") (pintype "input")))
    (net (code "5") (name "/CTRL")
      (node (ref "C2") (pin "1") (pintype "passive"))
      (node (ref "U1") (pin "5") (pinfunction "CV") (pintype "input")))
    (net (code "6") (name "/OUT")
      (node (ref "R3") (pin "1") (pintype "passive"))
      (node (ref "U1") (pin "3") (pinfunction "Q") (pintype "output")))
    (net (code "7") (name "/LED")
      (node (ref "D1") (pin "2") (pinfunction "A") (pintype "passive"))
      (node (ref "R3") (pin "2") (pintype "passive")))))
