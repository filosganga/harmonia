(export (version "E")
  (design
    (source "lm317_adjustable.kicad_sch")
    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "LM317 adjustable supply") (comment (number "1") (value "LM317 datasheet adjustable regulator with protection diodes: 240R and a 5k trimmer set the voltage, 10uF on ADJ, a power LED")))))
  (components
    (comp (ref "C1") (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C2") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C3") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C4") (value "100uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "D1") (value "1N4007") (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"))
    (comp (ref "D2") (value "1N4148") (footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal"))
    (comp (ref "D3") (value "LED") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "J1") (value "In") (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm"))
    (comp (ref "J2") (value "Out") (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm"))
    (comp (ref "R1") (value "240") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R2") (value "1k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "RV1") (value "5k") (footprint "Potentiometer_THT:Potentiometer_Bourns_3296W_Vertical"))
    (comp (ref "U1") (value "LM317") (footprint "Package_TO_SOT_THT:TO-220-3_Vertical")))
  (nets
    (net (code "1") (name "VIN") (node (ref "U1") (pin "3")) (node (ref "J1") (pin "1")) (node (ref "C1") (pin "1")) (node (ref "C4") (pin "1")) (node (ref "D1") (pin "1")))
    (net (code "2") (name "VOUT") (node (ref "U1") (pin "2")) (node (ref "R1") (pin "1")) (node (ref "D1") (pin "2")) (node (ref "D2") (pin "1")) (node (ref "C3") (pin "1")) (node (ref "R2") (pin "1")) (node (ref "J2") (pin "1")))
    (net (code "3") (name "ADJ") (node (ref "U1") (pin "1")) (node (ref "R1") (pin "2")) (node (ref "RV1") (pin "1")) (node (ref "C2") (pin "1")) (node (ref "D2") (pin "2")))
    (net (code "4") (name "GND") (node (ref "J1") (pin "2")) (node (ref "C1") (pin "2")) (node (ref "C4") (pin "2")) (node (ref "RV1") (pin "2")) (node (ref "RV1") (pin "3")) (node (ref "C2") (pin "2")) (node (ref "C3") (pin "2")) (node (ref "D3") (pin "1")) (node (ref "J2") (pin "2")))
    (net (code "5") (name "LEDA") (node (ref "R2") (pin "2")) (node (ref "D3") (pin "2")))))
