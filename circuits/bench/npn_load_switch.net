(export (version "E")
  (design
    (source "npn_load_switch.kicad_sch")
    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "NPN load switch for a microcontroller pin") (comment (number "1") (value "A BC547 switching a 12V load from a logic pin: base resistor and pull-down, flyback diode, an LED showing when it's on")))))
  (components
    (comp (ref "C1") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "D1") (value "1N4007") (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"))
    (comp (ref "D2") (value "LED") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "J1") (value "Logic in") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "J2") (value "Load") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "J3") (value "12V in") (footprint "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal"))
    (comp (ref "Q1") (value "BC547") (footprint "Package_TO_SOT_THT:TO-92_Inline_Wide"))
    (comp (ref "R1") (value "1k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R2") (value "10k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R3") (value "1k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")))
  (nets
    (net (code "1") (name "IN") (node (ref "J1") (pin "1")) (node (ref "R1") (pin "1")))
    (net (code "2") (name "BASE") (node (ref "R1") (pin "2")) (node (ref "R2") (pin "1")) (node (ref "Q1") (pin "2")))
    (net (code "3") (name "OUT") (node (ref "Q1") (pin "1")) (node (ref "D1") (pin "2")) (node (ref "J2") (pin "2")) (node (ref "D2") (pin "1")))
    (net (code "4") (name "+12V") (node (ref "D1") (pin "1")) (node (ref "J2") (pin "1")) (node (ref "R3") (pin "1")) (node (ref "J3") (pin "1")) (node (ref "C1") (pin "1")))
    (net (code "5") (name "GND") (node (ref "J1") (pin "2")) (node (ref "R2") (pin "2")) (node (ref "Q1") (pin "3")) (node (ref "J3") (pin "2")) (node (ref "C1") (pin "2")))
    (net (code "6") (name "LEDA") (node (ref "R3") (pin "2")) (node (ref "D2") (pin "2")))))
