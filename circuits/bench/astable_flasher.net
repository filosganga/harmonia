(export (version "E")
  (design
    (source "astable_flasher.kicad_sch")
    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "Two-transistor LED flasher") (comment (number "1") (value "Classic astable multivibrator: two BC547s cross-coupled through 10uF capacitors, an LED in each collector")))))
  (components
    (comp (ref "C1") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C2") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "D1") (value "LED") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "D2") (value "LED") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "J1") (value "Battery") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "Q1") (value "BC547") (footprint "Package_TO_SOT_THT:TO-92_Inline_Wide"))
    (comp (ref "Q2") (value "BC547") (footprint "Package_TO_SOT_THT:TO-92_Inline_Wide"))
    (comp (ref "R1") (value "470") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R2") (value "47k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R3") (value "47k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R4") (value "470") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")))
  (nets
    (net (code "1") (name "+9V") (node (ref "J1") (pin "1")) (node (ref "R1") (pin "1")) (node (ref "R2") (pin "1")) (node (ref "R3") (pin "1")) (node (ref "R4") (pin "1")))
    (net (code "2") (name "GND") (node (ref "J1") (pin "2")) (node (ref "Q1") (pin "3")) (node (ref "Q2") (pin "3")))
    (net (code "3") (name "L1") (node (ref "R1") (pin "2")) (node (ref "D1") (pin "2")))
    (net (code "4") (name "L2") (node (ref "R4") (pin "2")) (node (ref "D2") (pin "2")))
    (net (code "5") (name "Q1C") (node (ref "D1") (pin "1")) (node (ref "Q1") (pin "1")) (node (ref "C1") (pin "1")))
    (net (code "6") (name "Q2C") (node (ref "D2") (pin "1")) (node (ref "Q2") (pin "1")) (node (ref "C2") (pin "1")))
    (net (code "7") (name "Q1B") (node (ref "Q1") (pin "2")) (node (ref "C2") (pin "2")) (node (ref "R3") (pin "2")))
    (net (code "8") (name "Q2B") (node (ref "Q2") (pin "2")) (node (ref "C1") (pin "2")) (node (ref "R2") (pin "2")))))
