(export (version "E")
  (design
    (source "attiny85_board.kicad_sch")
    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "ATtiny85 board with ISP header") (comment (number "1") (value "ATtiny85 minimal circuit: 10k reset pull-up, decoupling, 6-pin AVR ISP header, two LEDs and an I/O header")))))
  (components
    (comp (ref "C1") (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C2") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "D1") (value "LED") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "D2") (value "LED") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "J1") (value "ISP") (footprint "Connector_PinHeader_2.54mm:PinHeader_2x03_P2.54mm_Vertical"))
    (comp (ref "J2") (value "Power") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "J3") (value "IO") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"))
    (comp (ref "R1") (value "10k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R2") (value "330") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R3") (value "330") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "U1") (value "ATtiny85") (footprint "Package_DIP:DIP-8_W7.62mm")))
  (nets
    (net (code "1") (name "+5V") (node (ref "U1") (pin "8")) (node (ref "J1") (pin "2")) (node (ref "R1") (pin "1")) (node (ref "C1") (pin "1")) (node (ref "C2") (pin "1")) (node (ref "J2") (pin "1")))
    (net (code "2") (name "GND") (node (ref "U1") (pin "4")) (node (ref "J1") (pin "6")) (node (ref "C1") (pin "2")) (node (ref "C2") (pin "2")) (node (ref "D1") (pin "1")) (node (ref "D2") (pin "1")) (node (ref "J2") (pin "2")) (node (ref "J3") (pin "4")))
    (net (code "3") (name "RESET") (node (ref "U1") (pin "1")) (node (ref "J1") (pin "5")) (node (ref "R1") (pin "2")))
    (net (code "4") (name "PB0") (node (ref "U1") (pin "5")) (node (ref "J1") (pin "4")) (node (ref "J3") (pin "1")))
    (net (code "5") (name "PB1") (node (ref "U1") (pin "6")) (node (ref "J1") (pin "1")) (node (ref "J3") (pin "2")))
    (net (code "6") (name "PB2") (node (ref "U1") (pin "7")) (node (ref "J1") (pin "3")) (node (ref "J3") (pin "3")))
    (net (code "7") (name "PB3") (node (ref "U1") (pin "2")) (node (ref "R2") (pin "1")))
    (net (code "8") (name "PB4") (node (ref "U1") (pin "3")) (node (ref "R3") (pin "1")))
    (net (code "9") (name "L1") (node (ref "R2") (pin "2")) (node (ref "D1") (pin "2")))
    (net (code "10") (name "L2") (node (ref "R3") (pin "2")) (node (ref "D2") (pin "2")))))
