(export (version "E")
  (design
    (source "lm386_amp.kicad_sch")
    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "LM386 audio amplifier, gain 20") (comment (number "1") (value "LM386 datasheet application 'Amplifier with gain = 20, minimum parts' (10k volume, 250uF out, 0.05uF + 10R Zobel), plus supply decoupling and bypass cap")))))
  (components
    (comp (ref "C1") (value "220uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C2") (value "47nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C3") (value "100uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C4") (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C5") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "J1") (value "Input") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "J2") (value "Speaker") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "J3") (value "Power") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "R1") (value "10") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "RV1") (value "10k") (footprint "Potentiometer_THT:Potentiometer_Bourns_3296W_Vertical"))
    (comp (ref "U1") (value "LM386") (footprint "Package_DIP:DIP-8_W7.62mm")))
  (nets
    (net (code "1") (name "AUDIO") (node (ref "J1") (pin "1")) (node (ref "RV1") (pin "1")))
    (net (code "2") (name "IN") (node (ref "RV1") (pin "2")) (node (ref "U1") (pin "3")))
    (net (code "3") (name "OUT") (node (ref "U1") (pin "5")) (node (ref "C1") (pin "1")) (node (ref "C2") (pin "1")))
    (net (code "4") (name "SPK") (node (ref "C1") (pin "2")) (node (ref "J2") (pin "1")))
    (net (code "5") (name "ZOBEL") (node (ref "C2") (pin "2")) (node (ref "R1") (pin "1")))
    (net (code "6") (name "BYPASS") (node (ref "U1") (pin "7")) (node (ref "C5") (pin "1")))
    (net (code "7") (name "+9V") (node (ref "U1") (pin "6")) (node (ref "C3") (pin "1")) (node (ref "C4") (pin "1")) (node (ref "J3") (pin "1")))
    (net (code "8") (name "GND") (node (ref "U1") (pin "2")) (node (ref "U1") (pin "4")) (node (ref "J1") (pin "2")) (node (ref "RV1") (pin "3")) (node (ref "R1") (pin "2")) (node (ref "C3") (pin "2")) (node (ref "C4") (pin "2")) (node (ref "C5") (pin "2")) (node (ref "J2") (pin "2")) (node (ref "J3") (pin "2")))))
