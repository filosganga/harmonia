(export (version "E")
  (design
    (source "lm7805_supply.kicad_sch")
    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "7805 5V supply") (comment (number "1") (value "L7805 datasheet fixed-output application (0.33uF in, 0.1uF out), plus a reverse-polarity diode, bulk caps and a power LED")))))
  (components
    (comp (ref "C1") (value "100uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C2") (value "330nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C3") (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C4") (value "10uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "D1") (value "1N4007") (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"))
    (comp (ref "D2") (value "LED") (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "J1") (value "DC in") (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm"))
    (comp (ref "J2") (value "5V out") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "R1") (value "1k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "U1") (value "L7805") (footprint "Package_TO_SOT_THT:TO-220-3_Vertical")))
  (nets
    (net (code "1") (name "VIN_RAW") (node (ref "J1") (pin "1")) (node (ref "D1") (pin "2")))
    (net (code "2") (name "VIN") (node (ref "D1") (pin "1")) (node (ref "C1") (pin "1")) (node (ref "C2") (pin "1")) (node (ref "U1") (pin "1")))
    (net (code "3") (name "+5V") (node (ref "U1") (pin "3")) (node (ref "C3") (pin "1")) (node (ref "C4") (pin "1")) (node (ref "R1") (pin "1")) (node (ref "J2") (pin "1")))
    (net (code "4") (name "GND") (node (ref "J1") (pin "2")) (node (ref "C1") (pin "2")) (node (ref "C2") (pin "2")) (node (ref "U1") (pin "2")) (node (ref "C3") (pin "2")) (node (ref "C4") (pin "2")) (node (ref "D2") (pin "1")) (node (ref "J2") (pin "2")))
    (net (code "5") (name "LED") (node (ref "R1") (pin "2")) (node (ref "D2") (pin "2")))))
