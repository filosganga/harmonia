(export (version "E")
  (design
    (source "h_bridge_bjt.kicad_sch")
    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "Transistor H-bridge for a small DC motor") (comment (number "1") (value "Two complementary BC557/BC547 half-bridges with their bases tied, each driven from a logic input, four flyback diodes")))))
  (components
    (comp (ref "C1") (value "100uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C2") (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "D1") (value "1N4148") (footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal"))
    (comp (ref "D2") (value "1N4148") (footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal"))
    (comp (ref "D3") (value "1N4148") (footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal"))
    (comp (ref "D4") (value "1N4148") (footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal"))
    (comp (ref "J1") (value "Control") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical"))
    (comp (ref "J2") (value "Motor") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "J3") (value "Power") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "Q1") (value "BC557") (footprint "Package_TO_SOT_THT:TO-92_Inline_Wide"))
    (comp (ref "Q2") (value "BC547") (footprint "Package_TO_SOT_THT:TO-92_Inline_Wide"))
    (comp (ref "Q3") (value "BC557") (footprint "Package_TO_SOT_THT:TO-92_Inline_Wide"))
    (comp (ref "Q4") (value "BC547") (footprint "Package_TO_SOT_THT:TO-92_Inline_Wide"))
    (comp (ref "R1") (value "1k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R2") (value "1k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")))
  (nets
