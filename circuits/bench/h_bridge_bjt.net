    (net (code "3") (name "MA") (node (ref "Q1") (pin "1")) (node (ref "Q2") (pin "1")) (node (ref "D1") (pin "2")) (node (ref "D2") (pin "1")) (node (ref "J2") (pin "1")))
    (net (code "4") (name "MB") (node (ref "Q3") (pin "1")) (node (ref "Q4") (pin "1")) (node (ref "D3") (pin "2")) (node (ref "D4") (pin "1")) (node (ref "J2") (pin "2")))
