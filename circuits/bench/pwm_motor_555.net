    (tool "hand-written")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "555 PWM motor speed controller") (comment (number "1") (value "555 astable with steering diodes around a pot for a variable duty cycle, driving an IRF540N low-side switch with a flyback diode")))))
  (components
    (comp (ref "C1") (value "10nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C2") (value "10nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "C3") (value "100uF") (footprint "Capacitor_THT:CP_Radial_D5.0mm_P2.50mm"))
    (comp (ref "C4") (value "100nF") (footprint "Capacitor_THT:C_Disc_D5.0mm_W2.5mm_P5.00mm"))
    (comp (ref "D1") (value "1N4148") (footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal"))
    (comp (ref "D2") (value "1N4148") (footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal"))
    (comp (ref "D3") (value "1N4007") (footprint "Diode_THT:D_DO-41_SOD81_P10.16mm_Horizontal"))
    (comp (ref "J1") (value "12V in") (footprint "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal"))
    (comp (ref "J2") (value "Motor") (footprint "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal"))
