    (comp (ref "R1") (value "1k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R2") (value "100") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "R3") (value "10k") (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal"))
    (comp (ref "RV1") (value "100k") (footprint "Potentiometer_THT:Potentiometer_Bourns_3296W_Vertical"))
    (comp (ref "U1") (value "NE555P") (footprint "Package_DIP:DIP-8_W7.62mm")))
